# Скопировать в .env.local и подставить свои значения
# Supabase → Project Settings → Data API → API URL (без /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Адрес публичного сайта, без слэша на конце. Используется в ссылке «Открыть сайт»
# и в карте сайта. Необязательно: по умолчанию https://qural-saiman.pages.dev
NEXT_PUBLIC_SITE_URL=https://qural-saiman.pages.dev
